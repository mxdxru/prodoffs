{
  "autoMemoryEnabled": false,
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^prodoffs-",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/prodoffs.py\" hook"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^prodoffs-",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/prodoffs.py\" hook"
          }
        ]
      }
    ]
  }
}
